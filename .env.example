# 复制为同目录的 .env，只在 .env 中填写真实 Key；不要提交 .env。
# 每行一个变量，等号两侧不要加空格。值用单引号包裹，不写命令。
# 由 IDEA 的环境变量文件功能或 ./run-local.sh 导入；Spring Boot 不会自动读取。

# 必填：OpenAI API Key（不是 ChatGPT 登录密码）。
OPENAI_API_KEY=''

# 模型 ID：修改后重启应用，同时核对模型的接口与参数支持。
OPENAI_MODEL='gpt-6-luna'

# Spring AI 2.x 官方 OpenAI API 根地址，包含 /v1，不追加 /chat/completions。
OPENAI_BASE_URL='https://api.openai.com/v1'

# 当前指南的模型参数；通过 application.yaml 中的占位符绑定。
OPENAI_REASONING_EFFORT='none'
OPENAI_MAX_COMPLETION_TOKENS='1024'

# 后端监听端口；已有 --server.port 程序参数会覆盖这里的值。
SERVER_PORT='8090'
