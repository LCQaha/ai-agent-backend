# 将 .env.example 复制为同目录的 .env，填写后从 IDEA、run-local.sh 或 Docker Compose 导入。
# 每行一个 KEY='value'。API Key 只填在本机或部署环境的 .env。

# 本地开发用 dev，生产部署用 prod。未指定 Profile 时使用 prod。
SPRING_PROFILES_ACTIVE='dev'

# 服务与模型请求的公共配置
SERVER_PORT='8090'
AI_REQUEST_TIMEOUT='120s'
AI_MAX_RETRIES='0'

# FirstApp 会话窗口：活跃历史超过触发轮数后，保留最近的完整轮次。
AI_MEMORY_TRIGGER_TURNS='20'
AI_MEMORY_KEEP_TURNS='10'

# 清理间隔由 Profile 决定：dev 为 10s，prod 为 10m。需要覆盖时取消注释。
# AI_SESSION_CLEANUP_INTERVAL='30s'

# Chat 聊天模型
# API 基址包含 /v1；模型 ID 以该服务实际提供的名称为准。
OPENAI_BASE_URL='https://api.openai.com/v1'
OPENAI_API_KEY=''
OPENAI_MODEL='gpt-6-luna'
OPENAI_REASONING_EFFORT='none'
OPENAI_MAX_COMPLETION_TOKENS='8192'

# Embedding 向量模型（默认模型 ID 沿用 Spring AI 2.0.1）
OPENAI_EMBEDDING_MODEL='text-embedding-ada-002'
# 默认复用上面的 OpenAI 地址和 Key。使用独立服务时，同时取消下面两行注释并填写。
# OPENAI_EMBEDDING_BASE_URL=''
# OPENAI_EMBEDDING_API_KEY=''
